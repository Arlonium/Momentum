{
  // Le code de l'application (navigateur) : sans les types de Node. Les tests e2e et les
  // fichiers de configuration ont `tsconfig.node.json`.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // Les types générés de `packages/protocol` importent sans extension : `bundler` les
    // résout (comme Vite), `nodenext` non.
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
